{
  "name": "jev-react-ui",
  "version": "0.1.0",
  "description": "Intelligent React inputs and controls powered by local decision models",
  "author": "George Pearse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgePearse/jev-react-ui.git"
  },
  "homepage": "https://github.com/GeorgePearse/jev-react-ui#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "open-jev": "^0.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
